# AI alignment providers (heuristic fallback if neither is set)
# Cloudflare Workers AI — free tier: https://dash.cloudflare.com → AI → Workers AI → API token
CF_API_TOKEN=
CF_ACCOUNT_ID=            # optional — auto-derived from S3_ENDPOINT if unset
# Google Gemini (alternative)
GEMINI_API_KEY=

# Cloudflare R2 (S3-compatible) — persists staged reviews & published translations
# Required on hosts with ephemeral filesystems (e.g. Render free tier)
# Either convention works:
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION="auto"

# or: R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
