# Gemini API key for real AI segment alignment (falls back to heuristic if unset)
GEMINI_API_KEY=

# Cloudflare R2 (S3-compatible) — persists staged reviews & published translations
# Required on hosts with ephemeral filesystems (e.g. Render free tier)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
